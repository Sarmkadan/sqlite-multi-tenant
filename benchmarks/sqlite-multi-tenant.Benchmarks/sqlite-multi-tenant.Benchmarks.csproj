<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Optimize>true</Optimize>
    <RootNamespace>SqliteMultiTenant.Benchmarks</RootNamespace>
    <AssemblyName>SqliteMultiTenant.Benchmarks</AssemblyName>
    <Authors>Vladyslav Zaiets</Authors>
    <Description>BenchmarkDotNet performance benchmarks for SqliteMultiTenant</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.14.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SqliteMultiTenant.csproj" />
  </ItemGroup>

</Project>
