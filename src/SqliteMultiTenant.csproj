<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SqliteMultiTenant</AssemblyName>
    <RootNamespace>SqliteMultiTenant</RootNamespace>
    <PackageId>Zaiets.sqlite.multi.tenant</PackageId>
    <Version>1.0.0</Version>
    <Authors>Vladyslav Zaiets</Authors>
    <Description>Multi-tenant SQLite database manager for .NET - per-tenant isolation, migrations, backups</Description>
    <PackageTags>sqlite multi-tenant database migration backup csharp dotnet</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/sarmkadan/sqlite-multi-tenant</PackageProjectUrl>
    <RepositoryUrl>https://github.com/sarmkadan/sqlite-multi-tenant</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Data.SQLite" Version="1.0.118" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="System.Reflection" Version="4.3.0" />
    <PackageReference Include="Microsoft.AspNetCore.App" Version="2.2.8" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Api\Controllers\**\*.cs" />
    <Compile Remove="Middleware\**\*.cs" />
    <Compile Remove="Formatters\CsvFormatter.cs" />
    <Compile Remove="Formatters\JsonFormatter.cs" />
    <Compile Remove="Formatters\XmlFormatter.cs" />
    <Compile Remove="Formatters\OutputFormatter.cs" />
    <Compile Remove="Validation\ValidationRuleBuilder.cs" />
    <Compile Remove="Events\DomainEventHandlers.cs" />
    <Compile Remove="Integration\WebhookService.cs" />
    <Compile Remove="Configuration\ServiceConfiguration.cs" />
    <Compile Remove="Cli\**\*.cs" />
    <Compile Remove="Caching\DistributedCacheService.cs" />
    <Compile Remove="Configuration\ServiceCollectionExtensions.cs" />
    <Compile Remove="Configuration\DependencyInjectionSetup.cs" />
  </ItemGroup>

</Project>