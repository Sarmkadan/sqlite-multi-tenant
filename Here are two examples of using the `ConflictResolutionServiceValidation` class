// Example 1: Validating a conflict resolution service
var conflictResolutionService = new ConflictResolutionService();
var validationErrors = ConflictResolutionServiceValidation.Validate(conflictResolutionService);
if (validationErrors.Any())
{
    foreach (var error in validationErrors)
    {
        Console.WriteLine(error);
    }
}
else
{
    Console.WriteLine("Conflict resolution service is valid");
}

// Example 2: Ensuring a conflict resolution service is valid
var conflictResolutionService2 = new ConflictResolutionService();
try
{
    ConflictResolutionServiceValidation.EnsureValid(conflictResolutionService2);
    Console.WriteLine("Conflict resolution service is valid");
}
catch (Exception ex)
{
    Console.WriteLine("Conflict resolution service is not valid: " + ex.Message);
}
